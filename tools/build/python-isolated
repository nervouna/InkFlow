#!/bin/sh

set -eu

if [ "$#" -eq 0 ]; then
  exec /usr/bin/python3 -I -S
fi

case "$1" in
  -*)
    exec /usr/bin/python3 -I -S "$@"
    ;;
  *)
    exec /usr/bin/python3 -I -S -c '
import os
import runpy
import sys

script = os.path.realpath(sys.argv[1])
sys.path.insert(0, os.path.dirname(script))
sys.argv = sys.argv[1:]
runpy.run_path(script, run_name="__main__")
' "$@"
    ;;
esac
