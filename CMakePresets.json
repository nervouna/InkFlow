{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "foundation",
      "displayName": "InkFlow foundation (Debug)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "foundation",
      "configurePreset": "foundation"
    }
  ],
  "testPresets": [
    {
      "name": "foundation",
      "configurePreset": "foundation",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
