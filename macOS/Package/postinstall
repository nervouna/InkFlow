#!/bin/bash
# Runs as the logged-in user after the payload is laid down: register, restore the input-source state
# (or enable it on a first install), relaunch and check the new build.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
state="$HOME/Library/Caches/io.damao.inkflow.installer/state.json"
trap 'rm -f "$state"' EXIT
if ! "$here/register-input-source" "$HOME/Library/Input Methods/InkFlow.app" --finish-update "$state"; then
  echo '墨流拼音安装未完成：请再次运行该安装包。' >&2
  exit 1
fi
